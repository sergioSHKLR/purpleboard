(kicad_pcb (version 20221018) (generator pcbnew)
  (general (thickness 1.6))
  (net 0 "")
  (net 1 "VBAT")
  (net 2 "SW")
  (net 3 "LED_A")
  (net 4 "GND")
  (gr_rect (start 0 0) (end 50 30) (layer "Edge.Cuts") (width 0.1))
  (gr_text "NIGHT LIGHT  REV A" (at 25 28) (layer "F.SilkS") (effects (font (size 1.4 1.4) (thickness 0.2))))

  (footprint "Battery:BatteryHolder_2xAA" (layer "F.Cu") (at 9 15)
    (property "Reference" "BT1") (property "Value" "3V")
    (pad "1" thru_hole rect (at 0 -5) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "VBAT"))
    (pad "2" thru_hole circle (at 0 5) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask") (net 4 "GND")))

  (footprint "Button_Switch_THT:SW_PUSH_6mm" (layer "F.Cu") (at 22 8)
    (property "Reference" "SW1") (property "Value" "PUSH")
    (pad "1" thru_hole circle (at -3 0) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 1 "VBAT"))
    (pad "2" thru_hole circle (at 3 0) (size 1.8 1.8) (drill 1) (layers "*.Cu" "*.Mask") (net 2 "SW")))

  (footprint "Resistor_THT:R_Axial_DIN0207" (layer "F.Cu") (at 32 8)
    (property "Reference" "R1") (property "Value" "~")
    (pad "1" thru_hole circle (at -4 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 2 "SW"))
    (pad "2" thru_hole circle (at 4 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 3 "LED_A")))

  (footprint "Resistor_THT:R_Axial_DIN0207" (layer "F.Cu") (at 32 16)
    (property "Reference" "R2") (property "Value" "~")
    (pad "1" thru_hole circle (at -4 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 2 "SW"))
    (pad "2" thru_hole circle (at 4 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask") (net 3 "LED_A")))

  (footprint "LED_THT:LED_D5.0mm" (layer "F.Cu") (at 44 15)
    (property "Reference" "D1") (property "Value" "Red")
    (pad "1" thru_hole rect (at 0 1.27) (size 1.8 1.8) (drill 0.9) (layers "*.Cu" "*.Mask") (net 4 "GND"))
    (pad "2" thru_hole circle (at 0 -1.27) (size 1.8 1.8) (drill 0.9) (layers "*.Cu" "*.Mask") (net 3 "LED_A")))

  (segment (start 9 10) (end 9 8) (width 0.6) (layer "F.Cu") (net 1))
  (segment (start 9 8) (end 19 8) (width 0.6) (layer "F.Cu") (net 1))
  (segment (start 25 8) (end 28 8) (width 0.6) (layer "F.Cu") (net 2))
  (segment (start 28 8) (end 28 16) (width 0.6) (layer "F.Cu") (net 2))
  (segment (start 36 16) (end 36 8) (width 0.6) (layer "F.Cu") (net 3))
  (segment (start 36 8) (end 44 8) (width 0.6) (layer "F.Cu") (net 3))
  (segment (start 44 8) (end 44 13.73) (width 0.6) (layer "F.Cu") (net 3))
  (segment (start 44 16.27) (end 44 24) (width 0.6) (layer "F.Cu") (net 4))
  (segment (start 44 24) (end 9 24) (width 0.6) (layer "F.Cu") (net 4))
  (segment (start 9 24) (end 9 20) (width 0.6) (layer "F.Cu") (net 4))
)
